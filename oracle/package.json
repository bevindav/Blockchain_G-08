{
  "name": "donation-oracle",
  "version": "1.0.0",
  "private": true,
  "description": "Payment oracle (Midtrans -> blockchain), off-ramp listener, IPFS & backend API untuk platform donasi",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.81.6",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
