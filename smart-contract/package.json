{
  "name": "donation-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "deploy:besu": "hardhat run scripts/deploy.js --network besu",
    "seed:besu": "hardhat run scripts/seed.js --network besu",
    "export-abi": "hardhat compile && node scripts/export-abi.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.2",
    "chai": "4.5.0",
    "ethers": "6.15.0",
    "hardhat": "2.28.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solc": "0.8.24",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  }
}
