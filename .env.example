# Salin menjadi .env lalu sesuaikan. Semua variabel opsional - tanpa .env sistem berjalan dalam mode mock.

# ---- Payment gateway (Midtrans Sandbox) ----------------------------------------
# Kosongkan untuk mode "mock" (simulator pembayaran bawaan, tanpa akun).
# Isi dari https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# mock | sandbox (otomatis "sandbox" bila MIDTRANS_SERVER_KEY diisi)
# MIDTRANS_MODE=sandbox

# URL frontend yang dilihat browser (dipakai untuk redirect setelah pembayaran)
FRONTEND_URL=http://localhost:3000

# ---- Oracle -------------------------------------------------------------------
# Default: akun development #3 (oracle) dan #9 (faucet/kustodian). Ganti untuk lingkungan non-lokal.
# ORACLE_PRIVATE_KEY=0x...
# FAUCET_PRIVATE_KEY=0x...
# CUSTODY_ADDRESS=0x...
# Interval rekonsiliasi Status API (ms) dan masa berlaku order (menit)
RECONCILE_INTERVAL_MS=20000
ORDER_TTL_MINUTES=60
MIN_DONATION=1000
MAX_DONATION=100000000

# ---- IPFS ---------------------------------------------------------------------
# Kosongkan untuk node Kubo lokal (docker). Isi JWT Pinata untuk pinning publik.
PINATA_JWT=

# ---- Docker compose -------------------------------------------------------------
# Heap JVM tiap node Besu (turunkan bila RAM terbatas, mis. 384m)
BESU_HEAP=512m
# false = jangan isi campaign demo saat deploy
SEED_DEMO=true
